<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 "title small" in the system font, sentence case — the main tabs' labels. -->
    <style name="TextAppearance.Aaps.Tab" parent="TextAppearance.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.007</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- The toolbar's overflow menu as a Material 3 menu rather than a square platform popup. -->
    <style name="ThemeOverlay.Aaps.ToolbarPopup" parent="">
        <item name="actionOverflowMenuStyle">@style/Widget.Aaps.OverflowMenu</item>
    </style>

    <style name="Widget.Aaps.OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/menu_popup_background</item>
        <item name="android:popupElevation">3dp</item>
    </style>

</resources>
